{
  "expo": {
    "name": "NutriLens",
    "slug": "NutriLens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutrilens",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutrilens.app"
    },
    "android": {
      "package": "com.nutrilens.app",
      "adaptiveIcon": {
        "backgroundColor": "#10B981",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#061220",
          "dark": {
            "backgroundColor": "#061220"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "NutriLens uses your camera to photograph food for AI-powered nutrition analysis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriLens accesses your photos to analyze food items and track your nutrition."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "NutriLens accesses your photo library to select food images for analysis.",
          "savePhotosPermission": "NutriLens saves your food photos for meal history.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#10B981",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
