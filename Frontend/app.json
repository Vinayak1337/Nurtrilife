{
  "expo": {
    "name": "NutriLife",
    "slug": "NutriLife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutrilife",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nutrilife.app",
      "infoPlist": {
        "NSCameraUsageDescription": "NutriLife uses your camera to photograph food for AI-powered nutrition analysis.",
        "NSPhotoLibraryUsageDescription": "NutriLife accesses your photos to analyze food items and track your nutrition.",
        "NSPhotoLibraryAddUsageDescription": "NutriLife saves food photos to your library for your records."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nutrilife.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#10B981"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#061220",
          "dark": {
            "backgroundColor": "#061220"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NutriLife uses your camera to photograph food for AI-powered nutrition analysis.",
          "microphonePermission": "NutriLife needs microphone access for video recording.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriLife accesses your photos to analyze food items and track your nutrition.",
          "cameraPermission": "NutriLife uses your camera to photograph food for AI-powered nutrition analysis."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#10B981",
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "92a97073-83a4-455a-836f-4b8e0fc88f48"
      },
      "router": {}
    },
    "owner": "vinayak1337"
  }
}
