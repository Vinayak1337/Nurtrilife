{
  "expo": {
    "name": "NutriLife",
    "slug": "NutriLens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutrilens",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nutrilens.app"
    },
    "android": {
      "package": "com.nutrilens.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#10B981"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#061220",
          "dark": {
            "backgroundColor": "#061220"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NutriLife uses your camera to photograph food for AI-powered nutrition analysis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriLife accesses your photos to analyze food items and track your nutrition."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#10B981",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "92a97073-83a4-455a-836f-4b8e0fc88f48"
      },
      "router": {}
    },
    "owner": "vinayak1337"
  }
}
